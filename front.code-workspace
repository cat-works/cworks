{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "wasm"
		}
	],
	"settings": {
		"cSpell.words": [
			"Syscall"
		],
		"rust-analyzer.check.command": "clippy",
		"rust-analyzer.check.extraArgs": [
			"--",
			"-W",
			"clippy::pedantic",
			"-A",
			"clippy::missing_errors_doc",
		],
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/.jj": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			"wasm": true
		},
		"Lua.completion.autoRequire": true,
		"Lua.codeLens.enable": true,
		"Lua.runtime.version": "Lua 5.4",
		"Lua.runtime.path": [
			"?.lua",
			"?/init.lua",
			"src/lib/lua/usr/lib/?.lua"
		],
		"Lua.workspace.library": [
			"src/lib/lua/types"
		],
		"Lua.diagnostics.globals": [
			"session",
			"env"
		]
	}
}